{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {"source": "/api", "destination": "/api/index.py"},
    {"source": "/api/:path*", "destination": "/api/index.py/:path*"}
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{tests/**,infra/**,frontend/**,.venv/**,.data/**,*.db,**/*.md,samples/**}"
    }
  }
}
