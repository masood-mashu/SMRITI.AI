SMRITI_ENV=development
SMRITI_VALIDATE_PRODUCTION=false
DATABASE_URL=postgresql+psycopg://smriti:smriti@localhost:5432/smriti
API_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=
EXTRACTION_PROVIDER=stub
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.1-pro
PII_PROVIDER=gemma_stub
GEMMA_PII_MODEL=gemma-3-27b-it
PHI_STRICT=false
OUTPUT_PROVIDER=stub
DOCTOR_BRIEF_MODEL=gemini-3.5-flash
EMERGENCY_MODEL=gemini-3.5-flash-lite
LANGUAGE_MODEL=gemini-3.5-flash
DB_AUTO_CREATE=false
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=.data/uploads
STORAGE_ENCRYPTION_KEY=
STORAGE_ENCRYPTION_REQUIRED=false
STORAGE_RETENTION_DAYS=0
STORE_RAW_EXTRACTION=false
API_TIMEOUT_SECONDS=60
EXTRACTION_MAX_OUTPUT_TOKENS=4096
OUTPUT_MAX_OUTPUT_TOKENS=2048
MAX_REQUEST_BYTES=12582912
UPLOAD_SIGNATURE_CHECK=false
GCS_BUCKET=
GCS_PREFIX=reports
GCS_KMS_KEY_NAME=
GCS_KMS_KEY_REQUIRED=false
AUTH_ENABLED=false
AUTH_MODE=token
SMRITI_API_TOKEN=
SMRITI_TOKEN_PATIENT_ID=
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
METRICS_BACKEND=memory
INGESTION_QUEUE_PROVIDER=inline
GCP_PROJECT=
INGESTION_QUEUE_LOCATION=
INGESTION_QUEUE_NAME=smriti-ingestion
INGESTION_WORKER_URL=
INGESTION_WORKER_TOKEN=
PROMPT_PROVIDER=local
AI_STUDIO_PROMPT_URL=
AI_STUDIO_API_KEY=
AUDIT_SINK=local
BIGQUERY_DATASET=
BIGQUERY_AUDIT_TABLE=smriti_audit_events
OTEL_ENABLED=false
OTEL_SERVICE_NAME=smriti-api
OTEL_EXPORTER_OTLP_ENDPOINT=
