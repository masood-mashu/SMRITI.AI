SMRITI_ENV=development
DATABASE_URL=postgresql+psycopg://smriti:smriti@localhost:5432/smriti
API_URL=http://localhost:8000
EXTRACTION_PROVIDER=stub
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.1-pro
PII_PROVIDER=gemma_stub
GEMMA_PII_MODEL=gemma-3-27b-it
PHI_STRICT=false
OUTPUT_PROVIDER=stub
DOCTOR_BRIEF_MODEL=gemini-3.5-flash
EMERGENCY_MODEL=gemini-3.5-flash-lite
LANGUAGE_MODEL=gemini-3.5-flash
DB_AUTO_CREATE=false
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=.data/uploads
STORAGE_ENCRYPTION_KEY=
STORAGE_ENCRYPTION_REQUIRED=false
STORAGE_RETENTION_DAYS=0
API_TIMEOUT_SECONDS=60
UPLOAD_SIGNATURE_CHECK=false
GCS_BUCKET=
GCS_PREFIX=reports
GCS_KMS_KEY_NAME=
GCS_KMS_KEY_REQUIRED=false
AUTH_ENABLED=false
AUTH_MODE=token
SMRITI_API_TOKEN=
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
PROMPT_PROVIDER=local
AI_STUDIO_PROMPT_URL=
AI_STUDIO_API_KEY=
AUDIT_SINK=local
BIGQUERY_DATASET=
BIGQUERY_AUDIT_TABLE=smriti_audit_events
OTEL_ENABLED=false
OTEL_SERVICE_NAME=smriti-api
OTEL_EXPORTER_OTLP_ENDPOINT=
